<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- application.yaml의 애플리케이션 이름을 가져옵니다. -->
    <springProperty
            scope="context"
            name="APPLICATION_NAME"
            source="spring.application.name"
            defaultValue="discodeit"
    />

    <!-- 프로젝트 루트를 기준으로 로그를 저장할 경로입니다. -->
    <property name="LOG_PATH" value=".logs"/>

    <!-- 현재 실행 중 작성되는 로그 파일입니다. -->
    <property
            name="LOG_FILE"
            value="${LOG_PATH}/${APPLICATION_NAME}.log"
    />

    <!--
        날짜 및 시간
        스레드 이름
        로그 레벨 5글자 정렬
        로거 이름 최대 36글자
        로그 메시지
        줄바꿈
    -->
    <property
            name="LOG_PATTERN"
            value="%d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"
    />

    <!-- 콘솔 로그 출력 -->
    <appender
            name="CONSOLE"
            class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 파일 로그 출력 -->
    <appender
            name="FILE"
            class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- 현재 로그가 기록되는 파일 -->
        <file>${LOG_FILE}</file>

        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <!-- 일자별 로그 롤링 -->
        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <!-- 날짜가 변경되면 기존 로그가 이 이름으로 저장됩니다. -->
            <fileNamePattern>
                ${LOG_PATH}/${APPLICATION_NAME}.%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <!-- 로그 파일을 30일 동안 보관합니다. -->
            <maxHistory>30</maxHistory>

            <!-- 애플리케이션 시작 시 오래된 로그를 정리합니다. -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- application.yaml의 logging.level 설정이 적용됩니다. -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>